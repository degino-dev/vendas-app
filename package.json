{
  "name": "vendas-app",
  "version": "0.5.0",
  "description": "App de controle de vendas para equipe comercial",
  "main": "./out/main/index.js",
  "author": "Décio Camargo",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "install-app-deps": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.deciocamargo.vendas",
    "productName": "Controle de Vendas",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "degino-dev",
        "repo": "vendas-app"
      }
    ]
  }
}
